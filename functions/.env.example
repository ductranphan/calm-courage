# Cloud Functions environment (NOT the Expo app .env).
# Set these in Firebase Console → Functions → Environment variables,
# or via your deploy pipeline — do not commit real values.

# Soft-launch default: leave unset or set to true so QA can activate a trial
# without a store receipt.
# Before public App Store / Play release: set to false AND implement receipt
# verification in index.js (TODO(store)).
ALLOW_UNVERIFIED_SUBSCRIPTION_GRANT=true
