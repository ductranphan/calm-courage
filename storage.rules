rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /parents/{parentId}/children/{childId}/{allPaths=**} {
      allow read: if request.auth != null
        && request.auth.uid == parentId;

      allow write: if request.auth != null
        && request.auth.uid == parentId
        && request.resource.size < 15 * 1024 * 1024;
    }
  }
}
